# Matrix homeserver URL
# Both variables must point to the same server
# NEXT_PUBLIC_ is read client-side by the SDK
# MATRIX_HOMESERVER is read server-side by the Next.js API routes (/api/login, /api/logout)
# Defaults to the public matrix.org server
NEXT_PUBLIC_MATRIX_HOMESERVER=https://matrix.org
MATRIX_HOMESERVER=https://matrix.org