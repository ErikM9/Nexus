# Matrix homeserver URL, defaulting to the public matrix.org server
# MATRIX_HOMESERVER is read server-side by the Next.js API routes (/api/login, /api/logout)
# NEXT_PUBLIC_MATRIX_HOMESERVER is the fallback when MATRIX_HOMESERVER is not set
# After sign-in the browser uses the base URL the login route reports
NEXT_PUBLIC_MATRIX_HOMESERVER=https://matrix.org
MATRIX_HOMESERVER=https://matrix.org